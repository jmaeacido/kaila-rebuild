[Unit]
Description=KAILA rebuild queue worker
After=network.target mysql.service redis-server.service

[Service]
Type=simple
User=ubuntu
Group=www-data
WorkingDirectory=/var/www/kaila-rebuild/apps/api
ExecStart=/usr/bin/php artisan queue:work redis --queue=outbox,default,maintenance --sleep=2 --tries=5 --max-time=3600
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
